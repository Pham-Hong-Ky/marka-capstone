NODE_ENV=test
PORT=5001
CLIENT_URL="http://localhost:5173"
APP_BASE_URL="http://localhost:5173"

# DB test riêng — DATABASE_URL bắt buộc chứa "_test" để tránh chạy nhầm vào DB dev.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marka_test?schema=public&connection_limit=5&pool_timeout=10"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/marka_test?schema=public"
# BullMQ yêu cầu Redis >= 5; nếu Redis local cũ, trỏ sang Upstash (rediss://).
REDIS_URL="redis://127.0.0.1:6379"

JWT_ACCESS_SECRET="marka_test_jwt_access_secret_32_chars_min"
JWT_REFRESH_SECRET="marka_test_jwt_refresh_secret_32_chars_min"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
AES_SECRET_KEY="marka_test_aes_secret_key_32_bytes!"

ENABLE_WORKERS="false"
