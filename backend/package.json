{
  "name": "marka-backend",
  "version": "1.0.0",
  "description": "Backend API for Marka AI Omnichannel Marketing platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
