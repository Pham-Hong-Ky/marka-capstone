{
  "name": "marka-backend",
  "version": "1.0.0",
  "description": "Backend API for Marka AI Omnichannel Marketing platform",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker-server.ts",
    "typecheck": "tsc --noEmit",
    "create:admin": "tsx scripts/create-admin.ts",
    "test:connection": "tsx scripts/test-connection.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "lint": "oxlint",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.0.0",
    "@payos/node": "^2.0.5",
    "@prisma/client": "^5.12.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.1.2",
    "cloudinary": "^2.10.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^10.9.1",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "isomorphic-dompurify": "^3.19.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "openai": "^6.49.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.0",
    "oxlint": "^1.75.0",
    "prisma": "^5.12.1",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.0.7"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
