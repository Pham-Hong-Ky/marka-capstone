PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# Database (PostgreSQL with Connection Pooling Limit)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marka?schema=public&connection_limit=20&pool_timeout=10"

# Redis (Caching & BullMQ)
REDIS_URL="redis://127.0.0.1:6379"

# JWT Secrets (At least 32 characters)
JWT_ACCESS_SECRET="marka_jwt_access_secret_super_secure_key_2026_dev"
JWT_REFRESH_SECRET="marka_jwt_refresh_secret_super_secure_key_2026_dev"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# AES-256 Secret Key (32 characters / 256-bit for OAuth Tokens)
AES_SECRET_KEY="marka_aes_secret_key_32_bytes_len!"

# Optional 3rd Party Integrations
OPENAI_API_KEY=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""

# Facebook Graph API (kết nối Facebook Page thật)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Email (Resend) — gửi lời mời, nhắc hạn gói / credit / lịch đăng
RESEND_API_KEY=""

# SMTP dự phòng (không bắt buộc)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="no-reply@marka.vn"

# URL frontend dùng để tạo link trong email
APP_BASE_URL="http://localhost:5173"

# Background workers (BullMQ)
# true  = chạy kèm API (dev, máy RAM ít)
# false = tắt ở API, chạy riêng bằng "npm run worker" (production)
ENABLE_WORKERS="true"
