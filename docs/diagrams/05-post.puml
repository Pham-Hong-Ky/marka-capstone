@startuml 05-post
hide circle
hide stereotype
!pragma layout smetana

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial
skinparam nodesep 40
skinparam ranksep 50
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  ArrowColor #475569
}

class "Post" as Post {
  + id : string
  + workspaceId : string
  + title : string
  + content : Json
  + status : PostStatus
  + taskStatus : TaskStatus
  + campaignTag : string?
  + rejectReason : string?
  + assigneeId : string?
  + assignedById : string?
  + assignedAt : Date?
  + dueAt : Date?
  + submittedById : string?
  + createdById : string?
  + submittedAt : Date?
  + reviewedById : string?
  + reviewedAt : Date?
  + deletedAt : Date?
  + createdAt : Date
  + updatedAt : Date
}

class "MediaAsset" as MediaAsset {
  + id : string
  + workspaceId : string
  + postId : string?
  + url : string
  + type : MediaType
  + mimeType : string?
  + thumbnailUrl : string?
  + size : number
  + tags : string?
  + source : MediaSource
  + createdById : string?
  + deletedAt : Date?
  + createdAt : Date
}

class "postController" as postController {
  + createPost(req, res)
  + getPost(req, res)
  + listPosts(req, res)
  + updatePost(req, res)
  + deletePost(req, res)
  + uploadPostMedia(req, res)
  + deletePostMedia(req, res)
  + submitPost(req, res)
  + reviewPost(req, res)
}

class "postService" as postService {
  - transitionPost(post, data)
  - assertEditable(post)
  - assertCanModify(post, userId, role)
  + createPost(workspaceId, userId, { title, content })
  + getPost(workspaceId, postId)
  + listPosts(workspaceId, query)
  + updatePost(workspaceId, userId, role, postId, data)
  + deletePost(workspaceId, userId, role, postId)
  + uploadPostMedia(workspaceId, userId, role, postId, file?)
  + deletePostMedia(workspaceId, userId, role, postId, mediaId)
  + submitPost(workspaceId, userId, userName, role, postId)
  + reviewPost(workspaceId, reviewerId, postId, { decision, rejectReason })
}

class "postRepository" as postRepository {
  + createPost(data)
  + getPostById(postId, workspaceId)
  + listPostsAndCount(params)
  + updatePost(postId, data)
  + transitionPostStatus(postId, workspaceId, from, data)
  + softDeletePost(postId)
  + createMedia(data)
  + findMediaByIdAndPost(postId, mediaId)
  + softDeleteMedia(mediaId)
}

class "MailerClient" as mailerClient {
  + sendEmail({ to, subject, html }) : Promise<boolean>
}

class "CloudinaryClient" as cloudinaryClient {
  + uploadImageBuffer(buffer, folder) : Promise<string>
}

postController ..> postService
postService ..> postRepository
postService ..> cloudinaryClient
postService ..> mailerClient
postRepository ..> Post
postRepository ..> MediaAsset

@enduml
