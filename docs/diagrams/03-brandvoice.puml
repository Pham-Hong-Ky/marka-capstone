@startuml 03-brandvoice
hide circle
hide stereotype
!pragma layout smetana
title Marka — Brand Voice

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial
skinparam nodesep 30
skinparam ranksep 50
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  ArrowColor #475569
}

class "brandVoiceController" as brandVoiceController {
  - brandVoiceService : brandVoiceService
  + getBrandVoice(req, res)
  + updateBrandVoice(req, res)
}

class "brandVoiceService" as brandVoiceService {
  - brandVoiceRepository : brandVoiceRepository
  - dedupeKeywords(keywords) : string[]
  + getBrandVoice(workspaceId)
  + updateBrandVoice(workspaceId, userId, data)
}

class "brandVoiceRepository" as brandVoiceRepository {
  - prisma : PrismaClient
  + findWorkspaceById(workspaceId)
  + getWorkspaceBrandVoice(workspaceId)
  + updateWorkspaceBrandVoice(workspaceId, brandVoice)
}

brandVoiceController --> brandVoiceService
brandVoiceService --> brandVoiceRepository

@enduml
