@startuml 03-brandvoice
!pragma layout smetana
skinparam dpi 120
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #37474F
  ArrowColor #455A64
  FontSize 12
}
hide circle
title Brand Voice — Class Diagram

class BrandVoiceController {
  - brandVoiceService : BrandVoiceService
  + getBrandVoice(workspaceId : string) : BrandVoiceDTO
  + createBrandVoice(workspaceId : string, input : BrandVoiceDTO) : BrandVoiceDTO
  + updateBrandVoice(workspaceId : string, input : BrandVoiceDTO) : BrandVoiceDTO
  + deleteBrandVoice(workspaceId : string) : void
}
class BrandVoiceService {
  - brandVoiceRepository : BrandVoiceRepository
  + createBrandVoice(workspaceId : string, input : BrandVoiceDTO) : BrandVoiceDTO
  + getBrandVoice(workspaceId : string) : BrandVoiceDTO
  + updateBrandVoice(workspaceId : string, input : BrandVoiceDTO) : BrandVoiceDTO
  + deleteBrandVoice(workspaceId : string) : void
}
class BrandVoiceRepository {
  - prisma : PrismaClient
  + createBrandVoiceRecord(workspaceId : string, data : BrandVoiceDTO) : Json
  + findBrandVoiceByWorkspace(workspaceId : string) : Json
  + updateBrandVoiceRecord(workspaceId : string, data : BrandVoiceDTO) : Json
  + deleteBrandVoiceRecord(workspaceId : string) : Json
}

BrandVoiceController --> BrandVoiceService
BrandVoiceService ..> BrandVoiceRepository
@enduml
