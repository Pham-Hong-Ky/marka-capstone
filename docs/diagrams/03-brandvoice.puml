@startuml 03-brandvoice
hide circle
hide stereotype
!pragma layout smetana

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial
skinparam nodesep 40
skinparam ranksep 50
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  ArrowColor #475569
}

class "Workspace" as Workspace {
  + id : string
  + name : string
  + plan : WorkspacePlan
  + remainingCredit : number
  + monthlyQuota : number
  + planExpiresAt : Date?
  + billingCycleStart : Date?
  + nextResetAt : Date?
  + planExpiryWarningSentAt : Date?
  + creditWarningSentAt : Date?
  + brandVoice : Json?
  + deletedAt : Date?
  + createdAt : Date
  + updatedAt : Date
}

class "brandVoiceController" as brandVoiceController {
  + getBrandVoice(req, res)
  + updateBrandVoice(req, res)
}

class "brandVoiceService" as brandVoiceService {
  - dedupeKeywords(keywords) : string[]
  + getBrandVoice(workspaceId)
  + updateBrandVoice(workspaceId, userId, data)
}

class "brandVoiceRepository" as brandVoiceRepository {
  + findWorkspaceById(workspaceId)
  + getBrandVoiceByWorkspaceId(workspaceId)
  + updateWorkspaceBrandVoice(workspaceId, brandVoice)
}

brandVoiceController ..> brandVoiceService
brandVoiceService ..> brandVoiceRepository
brandVoiceRepository ..> Workspace

@enduml
