@startuml 03-brandvoice
!pragma layout smetana
skinparam dpi 120
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #37474F
  ArrowColor #455A64
  FontSize 12
}
skinparam stereotypeCBackgroundColor #90CAF9
title Brand Voice — Class Diagram

package "brandvoice" #FFF3E0 {
  class BrandVoiceController <<Controller>> {
    - brandVoiceService : BrandVoiceService
    + getBrandVoice(workspaceId : string) : BrandVoiceDTO
    + createBrandVoice(workspaceId : string, input : BrandVoiceDTO) : BrandVoiceDTO
    + updateBrandVoice(workspaceId : string, input : BrandVoiceDTO) : BrandVoiceDTO
    + deleteBrandVoice(workspaceId : string) : void
  }
  class BrandVoiceService <<Service>> {
    - brandVoiceRepository : BrandVoiceRepository
    + createBrandVoice(workspaceId : string, input : BrandVoiceDTO) : BrandVoiceDTO
    + getBrandVoice(workspaceId : string) : BrandVoiceDTO
    + updateBrandVoice(workspaceId : string, input : BrandVoiceDTO) : BrandVoiceDTO
    + deleteBrandVoice(workspaceId : string) : void
  }
  class BrandVoiceRepository <<Repository>> {
    - prisma : PrismaClient
    + createBrandVoiceRecord(workspaceId : string, data : BrandVoiceDTO) : Json
    + findBrandVoiceByWorkspace(workspaceId : string) : Json
    + updateBrandVoiceRecord(workspaceId : string, data : BrandVoiceDTO) : Json
    + deleteBrandVoiceRecord(workspaceId : string) : Json
  }
}

class BrandVoiceDTO <<DTO>> {
  - industry : string
  - targetAudience : string
  - writingStyle : string
  - keywordsShouldUse : string[]
  - keywordsAvoid : string[]
  - fewShotExamples : string[]
}

BrandVoiceController --> BrandVoiceService
BrandVoiceService ..> BrandVoiceRepository
BrandVoiceRepository ..> BrandVoiceDTO

note bottom of BrandVoiceRepository
  Brand Voice duoc luu trong **Workspace.brandVoice (Json)**,
  khong co bang rieng.
end note
@enduml
