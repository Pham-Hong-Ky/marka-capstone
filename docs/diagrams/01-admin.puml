@startuml 01-admin
!pragma layout smetana
skinparam dpi 120
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #37474F
  ArrowColor #455A64
  FontSize 12
}
hide circle
title Admin — Class Diagram

class AdminController {
  - adminService : AdminService
  + getDashboardStats(workspaceId : string) : DashboardStatsDTO
}
class AdminService {
  - adminRepository : AdminRepository
  + getDashboardStats(workspaceId : string) : DashboardStatsDTO
}
class AdminRepository {
  - prisma : PrismaClient
  + aggregateUsersAndWorkspaces() : UserWorkspaceStats
  + aggregateCreditAndRevenue(workspaceId : string) : CreditRevenueStats
}

AdminController --> AdminService
AdminService ..> AdminRepository
@enduml
