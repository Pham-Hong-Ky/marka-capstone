@startuml 04-channel
hide circle
hide stereotype
!pragma layout smetana

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial
skinparam nodesep 40
skinparam ranksep 50
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  ArrowColor #475569
}

class "ChannelConnection" as ChannelConnection {
  + id : string
  + workspaceId : string
  + platform : SocialPlatform
  + type : ChannelType
  + name : string
  + label : string?
  + avatar : string?
  + externalAccountId : string
  + accessToken : string?
  + status : ChannelStatus
  + createdAt : Date
  + updatedAt : Date
}

class "channelController" as channelController {
  + listChannels(req, res)
  + getFacebookAuthUrl(req, res)
  + facebookCallback(req, res)
  + getPendingFacebookPages(req, res)
  + connectFacebookPages(req, res)
  + disconnectChannel(req, res)
}

class "channelService" as channelService {
  - buildClientRedirect(params) : string
  - errorRedirect(reason) : string
  - getSessionForUser(sessionId, userId, workspaceId)
  + listChannels(workspaceId)
  + createFacebookAuthUrl(workspaceId, userId)
  + handleFacebookCallback(query)
  + getFacebookPendingPages(sessionId, userId, workspaceId)
  + connectFacebookPages(sessionId, userId, workspaceId, pageIds)
  + disconnectChannel(channelId, workspaceId, userId)
  + verifyChannelToken(channelId, workspaceId)
}

class "channelRepository" as channelRepository {
  + findChannelsByWorkspace(workspaceId)
  + upsertFacebookChannels(workspaceId, pages)
  + findChannelInWorkspace(channelId, workspaceId)
  + findChannelWithToken(channelId, workspaceId)
  + updateChannelStatus(channelId, status)
  + deleteChannelAndCancelSchedules(channelId)
}

class "FacebookClient" as facebookClient {
  + isFacebookConfigured() : boolean
  + buildAuthorizationUrl(state) : string
  + isTokenExpiredError(error) : boolean
  - graphGet(path, params) : Promise<T>
  + exchangeCodeForToken(code) : Promise<string>
  + exchangeForLongLivedToken(token) : Promise<string>
  + fetchManagedPages(userToken) : Promise<FacebookPage[]>
  + verifyPageToken(pageToken) : Promise<boolean>
}

class "oauthStore" as oauthStore {
  + saveOauthState(state, { userId, workspaceId }) : Promise<void>
  + consumeOauthState(state) : Promise<OauthState | null>
  + saveOauthSession(sessionId, session) : Promise<void>
  + getOauthSession(sessionId) : Promise<OauthSession | null>
  + deleteOauthSession(sessionId) : Promise<void>
}

channelController ..> channelService
channelService ..> channelRepository
channelService ..> facebookClient
channelService ..> oauthStore
channelRepository ..> ChannelConnection

@enduml
