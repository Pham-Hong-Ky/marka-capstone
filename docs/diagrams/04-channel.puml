@startuml 04-channel
hide circle
hide stereotype
!pragma layout smetana

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial
skinparam nodesep 40
skinparam ranksep 50
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  ArrowColor #475569
}

class "ChannelConnection" as ChannelConnection {
  + id : string
  + workspaceId : string
  + platform : SocialPlatform
  + type : ChannelType
  + name : string
  + label : string?
  + avatar : string?
  + externalAccountId : string
  + accessToken : string?
  + status : ChannelStatus
  + deletedAt : Date?
  + createdAt : Date
  + updatedAt : Date
}

class "channelController" as channelController {
  + listChannels(req, res)
  + getOauthUrl(req, res)
  + oauthCallback(req, res)
  + getPendingAccounts(req, res)
  + connectAccounts(req, res)
  + disconnectChannel(req, res)
  + getChannelDetail(req, res)
  + updateChannelLabel(req, res)
  + refreshChannel(req, res)
}

class "channelService" as channelService {
  - buildClientRedirect(params) : string
  - errorRedirect(platform, reason) : string
  - getSessionForUser(sessionId, userId, workspaceId)
  + listChannels(workspaceId)
  + createAuthUrl(platform, workspaceId, userId)
  + handleOauthCallback(platform, query)
  + getPendingAccounts(platform, sessionId, userId, workspaceId)
  + connectAccounts(platform, sessionId, userId, workspaceId, accountIds)
  + disconnectChannel(channelId, workspaceId, userId)
  + getChannelDetail(channelId, workspaceId)
  + updateChannelLabel(channelId, workspaceId, userId, label)
  + refreshChannel(channelId, workspaceId)
}

class "channelRepository" as channelRepository {
  + findChannelsByWorkspace(workspaceId)
  + upsertChannels(workspaceId, platform, accounts)
  + findChannelInWorkspace(channelId, workspaceId)
  + findChannelDetail(channelId, workspaceId)
  + findChannelWithToken(channelId, workspaceId)
  + findChannelsWithRefreshableTokens(platforms)
  + updateChannelToken(channelId, accessToken)
  + updateChannelStatus(channelId, status)
  + updateChannelProfile(channelId, data)
  + disconnectChannelAndCancelSchedules(channelId)
}

class "ProviderRegistry" as providerRegistry {
  + getProvider(platform) : SocialProvider
  + listProviders() : SocialProvider[]
}

class "FacebookProvider" as facebookProvider {
  + exchangeCodeForAccounts(code) : Promise<SocialAccount[]>
  + publish(input) : Promise<string>
  + fetchMetrics(...)
  + refreshProfile(...)
  + supportsPublish : true
  + supportsMetrics : true
  + supportsTokenRefresh : false
}

class "ThreadsProvider" as threadsProvider {
  + exchangeCodeForAccounts(code) : Promise<SocialAccount[]>
  + publish(input) : Promise<string>
  + fetchMetrics(...)
  + refreshToken(token) : Promise<string>
  + supportsPublish : true
  + supportsMetrics : true
  + supportsTokenRefresh : true
}

class "oauthStore" as oauthStore {
  + saveOauthState(state, { userId, workspaceId, platform }) : Promise<void>
  + consumeOauthState(state) : Promise<OauthState | null>
  + saveOauthSession(sessionId, session) : Promise<void>
  + getOauthSession(sessionId) : Promise<OauthSession | null>
  + deleteOauthSession(sessionId) : Promise<void>
}

channelController ..> channelService
channelService ..> channelRepository
channelService ..> providerRegistry
channelService ..> oauthStore
channelRepository ..> ChannelConnection
providerRegistry --> facebookProvider
providerRegistry --> threadsProvider

@enduml
