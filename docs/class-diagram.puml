@startuml class-diagram-overview
hide circle
hide stereotype
!pragma layout smetana
title Marka — Sơ đồ lớp tổng quan

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial
skinparam nodesep 26
skinparam ranksep 40
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  ArrowColor #475569
}

class "authController" as authController
class "authService" as authService
class "userController" as userController
class "userService" as userService
class "userRepository" as userRepository

class "workspaceController" as workspaceController
class "workspaceService" as workspaceService
class "workspaceRepository" as workspaceRepository

class "brandVoiceController" as brandVoiceController
class "brandVoiceService" as brandVoiceService
class "brandVoiceRepository" as brandVoiceRepository

class "channelController" as channelController
class "channelService" as channelService
class "channelRepository" as channelRepository

class "postController" as postController
class "postService" as postService
class "postRepository" as postRepository
class "PostNotification" as postNotification

class "GoogleOAuth2Client" as googleOAuthClient
class "MailerClient" as mailerClient
class "CloudinaryClient" as cloudinaryClient
class "FacebookClient" as facebookClient

authController --> authService
authService --> userRepository
authService --> googleOAuthClient
userController --> userService
userService --> userRepository

workspaceController --> workspaceService
workspaceService --> workspaceRepository
workspaceService --> mailerClient

brandVoiceController --> brandVoiceService
brandVoiceService --> brandVoiceRepository

channelController --> channelService
channelService --> channelRepository
channelService --> facebookClient

postController --> postService
postService --> postRepository
postService --> postNotification
postService --> cloudinaryClient
postNotification --> mailerClient

@enduml
