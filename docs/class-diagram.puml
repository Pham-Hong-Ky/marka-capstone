' ============================================================
' 10. AUTOMATION — Queue (BullMQ) + Worker
'     Dung cho: AI gen, Post publish, Email/Notification
' ============================================================
package "automation — queue (BullMQ)" #F3E5F5 {
  class QueueManager <<Queue>> {
    - connection : Redis
    - queues : Map~string,Queue~
    - defaultJobOptions : JobOptions
    + getQueue(queueName : string) : Queue
    + enqueue(queueName : string, jobName : string, data : Json, opts : JobOptions) : Job
    + addDelayed(queueName : string, jobName : string, data : Json, runAt : DateTime) : Job
    + cancelJob(queueName : string, jobId : string) : void
    + getJobStatus(queueName : string, jobId : string) : JobStatus
    + pauseQueue(queueName : string) : void
    + resumeQueue(queueName : string) : void
    + closeAll() : void
  }
  abstract class BaseWorker <<Worker>> {
    # queueName : string
    # connection : Redis
    # concurrency : int
    # queue : Queue
    + start() : void
    + process(job : Job) : Json
    + onCompleted(job : Job, result : Json) : void
    + onFailed(job : Job, err : Error) : void
    + close() : void
  }
  class ContentGenerationQueue <<Queue>> {
    - name : string = "content-generation-queue"
    + addTextJob(payload : AiJobPayload) : Job
    + addImageJob(payload : AiJobPayload) : Job
  }
  class PublishingQueue <<Queue>> {
    - name : string = "publishing-queue"
    + addPublishJob(scheduledPostId : string, runAt : DateTime) : Job
    + cancelJob(scheduledPostId : string) : void
  }
  class EmailQueue <<Queue>> {
    - name : string = "email-queue"
    + addInviteEmail(payload : EmailPayload) : Job
    + addReminderEmail(payload : EmailPayload) : Job
  }
  class AiGenerationWorker <<Worker>> {
    - openAIClient : OpenAIClient
    - aiRepository : AIRepository
    - aiService : AIService
    + process(job : Job) : Json
  }
  class PublishingWorker <<Worker>> {
    - postService : PostService
    - facebookClient : FacebookClient
    - postRepository : PostRepository
    + process(job : Job) : Json
    + simulatePublish(scheduledPost : ScheduledPost) : PublishResult
  }
  class EmailWorker <<Worker>> {
    - mailServiceClient : MailServiceClient
    + process(job : Job) : Json
  }
  class ScheduledPostScanner <<Cron>> {
    - cronExpression : string
    - publishingQueue : PublishingQueue
    - postRepository : PostRepository
    + start() : void
    + stop() : void
    + scanDuePosts() : void
  }
}

' ============================================================
' 11. AUTOMATION — n8n workflow orchestration
'     CHI dung cho Post Analytics: dong bo metrics Facebook (D21).
'     Dang bai (publishing) dung BullMQ — n8n KHONG tham gia.
'     Cac module khac (Admin, Order, AI, Workspace, Auth...) KHONG dung n8n.
' ============================================================
package "automation — n8n (chi Post Analytics — dong bo metrics)" #FCE4EC {
  class N8nClient <<Client>> {
    - baseUrl : string
    - apiKey : string
    - webhookSecret : string
    - timeoutMs : int
    - httpClient : HttpClient
    + triggerWorkflow(workflowKey : string, payload : Json) : ExecutionInfo
    + getExecution(executionId : string) : ExecutionInfo
    + cancelExecution(executionId : string) : void
    + registerWebhook(eventKey : string, targetUrl : string) : void
    + verifyWebhookSignature(signature : string, rawBody : string) : boolean
  }
  class MetricsSyncWorkflow <<Service>> {
    - n8nClient : N8nClient
    - postRepository : PostRepository
    + runMetricsSync(scheduledPostId : string) : ExecutionInfo
    + handleMetricsResult(payload : Json) : void
  }
  class N8nWebhookController <<Controller>> {
    - metricsWorkflow : MetricsSyncWorkflow
    + handleCallback(req : RawRequest) : void
  }
}

