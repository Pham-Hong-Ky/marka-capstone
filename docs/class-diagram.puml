@startuml class-diagram-overview
left to right direction
hide circle
hide stereotype
!pragma layout smetana

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial
skinparam nodesep 34
skinparam ranksep 44
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  ArrowColor #475569
}


' ================= THỰC THỂ =================
package "Người dùng & Workspace" {
  class "User" as User {
    + id : string
    + email : string
    + passwordHash : string?
    + name : string
    + avatar : string?
    + authProvider : AuthProvider
    + googleId : string?
    + emailVerified : boolean
    + systemRole : SystemRole
    + tokenVersion : number
    + isSuspended : boolean
    + deletedAt : Date?
    + createdAt : Date
    + updatedAt : Date
  }

  class "Workspace" as Workspace {
    + id : string
    + name : string
    + plan : WorkspacePlan
    + remainingCredit : number
    + monthlyQuota : number
    + planExpiresAt : Date?
    + billingCycleStart : Date?
    + nextResetAt : Date?
    + planExpiryWarningSentAt : Date?
    + creditWarningSentAt : Date?
    + brandVoice : Json?
    + deletedAt : Date?
    + createdAt : Date
    + updatedAt : Date
  }

  class "WorkspaceMember" as WorkspaceMember {
    + id : string
    + workspaceId : string
    + userId : string
    + role : WorkspaceRole
    + allowDirectPublish : boolean
    + createdAt : Date
    + updatedAt : Date
  }

  class "WorkspaceInvite" as WorkspaceInvite {
    + id : string
    + email : string
    + workspaceId : string
    + role : WorkspaceRole
    + token : string
    + isUsed : boolean
    + expiresAt : Date
    + invitedById : string?
    + createdAt : Date
  }
}

package "Nội dung & Kênh" {
  class "Post" as Post {
    + id : string
    + workspaceId : string
    + title : string
    + content : Json
    + status : PostStatus
    + taskStatus : TaskStatus
    + campaignTag : string?
    + rejectReason : string?
    + assigneeId : string?
    + assignedById : string?
    + assignedAt : Date?
    + dueAt : Date?
    + submittedById : string?
    + createdById : string?
    + submittedAt : Date?
    + reviewedById : string?
    + reviewedAt : Date?
    + deletedAt : Date?
    + createdAt : Date
    + updatedAt : Date
  }

  class "MediaAsset" as MediaAsset {
    + id : string
    + workspaceId : string
    + postId : string?
    + url : string
    + type : MediaType
    + mimeType : string?
    + thumbnailUrl : string?
    + size : number
    + tags : string?
    + source : MediaSource
    + createdById : string?
    + deletedAt : Date?
    + createdAt : Date
  }

  class "ChannelConnection" as ChannelConnection {
    + id : string
    + workspaceId : string
    + platform : SocialPlatform
    + type : ChannelType
    + name : string
    + label : string?
    + avatar : string?
    + externalAccountId : string
    + accessToken : string?
    + status : ChannelStatus
    + createdAt : Date
    + updatedAt : Date
  }

  class "ScheduledPost" as ScheduledPost {
    + id : string
    + postId : string
    + channelId : string
    + customContent : Json?
    + scheduledAt : Date?
    + status : PublishStatus
    + externalPostId : string?
    + errorMessage : string?
    + retryCount : number
    + processingStartedAt : Date?
    + retryAt : Date?
    + publishedAt : Date?
    + reminderSentAt : Date?
    + createdAt : Date
    + updatedAt : Date
  }

  class "PostMetric" as PostMetric {
    + id : string
    + scheduledPostId : string
    + reactions : number
    + reactionsDetail : Json?
    + comments : number
    + shares : number
    + reach : number?
    + impressions : number?
    + permalinkUrl : string?
    + syncError : string?
    + fetchedAt : Date?
    + createdAt : Date
    + updatedAt : Date
  }
}

package "AI & Credit" {
  class "AiGeneration" as AiGeneration {
    + id : string
    + workspaceId : string
    + userId : string?
    + postId : string?
    + type : AiGenType
    + provider : string
    + model : string
    + status : AiGenStatus
    + prompt : string
    + response : string?
    + errorMessage : string?
    + creditCost : number
    + createdAt : Date
    + updatedAt : Date
  }

  class "CreditTransaction" as CreditTransaction {
    + id : string
    + workspaceId : string
    + type : CreditFlowType
    + action : CreditActionType
    + amount : number
    + balanceBefore : number
    + balanceAfter : number
    + reason : string?
    + createdById : string?
    + createdAt : Date
  }

  class "CreditPackage" as CreditPackage {
    + id : string
    + name : string
    + description : string?
    + creditAmount : number
    + price : number
    + sortOrder : number
    + isActive : boolean
    + deletedAt : Date?
    + createdAt : Date
    + updatedAt : Date
  }

  class "Order" as Order {
    + id : string
    + orderCode : string
    + workspaceId : string
    + packageId : string?
    + amount : number
    + creditAmount : number?
    + targetPlan : WorkspacePlan?
    + paymentLinkId : string?
    + checkoutUrl : string?
    + expiresAt : Date?
    + payosTransId : string?
    + paidAt : Date?
    + status : OrderStatus
    + createdById : string?
    + createdAt : Date
    + updatedAt : Date
  }
}

package "Thông báo & Audit" {
  class "Notification" as Notification {
    + id : string
    + userId : string
    + workspaceId : string?
    + type : string
    + payload : Json
    + isRead : boolean
    + createdAt : Date
  }

  class "AuditLog" as AuditLog {
    + id : string
    + workspaceId : string?
    + actorId : string?
    + action : string
    + targetType : string
    + targetId : string?
    + reason : string?
    + metadata : Json?
    + createdAt : Date
  }
}


' ================= LỚP NGHIỆP VỤ =================
' ===== AUTH & USER =====
together {
class "authController" as authController {
  + register(req, res)
  + login(req, res)
  + googleLogin(req, res)
  + logout(req, res)
  + refreshToken(req, res)
}

class "authService" as authService {
  + registerUser(data)
  + login(email, password)
  + googleLogin(idToken)
  + logout(userId?)
  + refreshToken(token?)
}

class "GoogleOAuth2Client" as googleOAuthClient {
  + verifyIdToken({ idToken, audience })
}

class "userController" as userController {
  + getMe(req, res)
  + updateProfile(req, res)
  + changePassword(req, res)
}

class "userService" as userService {
  + getProfile(userId)
  + updateProfile(userId, data)
  + changePassword(userId, oldPassword, newPassword)
}

class "userRepository" as userRepository {
  + findUserById(userId)
  + findUserByEmail(email)
  + createUserWithDefaultWorkspace(data)
  + linkGoogleAccount(userId, data)
  + updateUser(userId, data)
  + incrementTokenVersion(userId)
}
}

' ===== WORKSPACE =====
together {
class "workspaceController" as workspaceController {
  + createWorkspace(req, res)
  + listWorkspaces(req, res)
  + updateWorkspace(req, res)
  + deleteWorkspace(req, res)
  + listMembers(req, res)
  + inviteMember(req, res)
  + acceptInvite(req, res)
  + leaveWorkspace(req, res)
  + removeMember(req, res)
  + changeMemberRole(req, res)
}

class "workspaceService" as workspaceService {
  + createWorkspace(userId, data)
  + listMyWorkspaces(userId)
  + updateWorkspace(workspaceId, userId, data)
  + deleteWorkspace(workspaceId, userId)
  + listMembers(workspaceId)
  + inviteMember(workspaceId, inviter, data)
  + acceptInvite(token, currentUser?)
  + leaveWorkspace(workspaceId, userId)
  + removeMember(workspaceId, actorId, targetUserId)
  + changeMemberRole(workspaceId, actorId, targetUserId, role)
}

class "workspaceRepository" as workspaceRepository {
  + findWorkspacesByUserId(userId)
  + findWorkspaceById(workspaceId)
  + createWorkspaceWithOwner(data, ownerId)
  + findMembersByWorkspace(workspaceId)
  + findMember(workspaceId, userId)
  + createInvite(data)
  + acceptInviteAsMember(inviteId, workspaceId, userId, role)
}

class "MailerClient" as mailerClient {
  + sendEmail({ to, subject, html })
}
}

' ===== BRAND VOICE =====
together {
class "brandVoiceController" as brandVoiceController {
  + getBrandVoice(req, res)
  + updateBrandVoice(req, res)
}

class "brandVoiceService" as brandVoiceService {
  + getBrandVoice(workspaceId)
  + updateBrandVoice(workspaceId, userId, data)
}

class "brandVoiceRepository" as brandVoiceRepository {
  + getBrandVoiceByWorkspaceId(workspaceId)
  + updateWorkspaceBrandVoice(workspaceId, brandVoice)
}
}

' ===== CHANNEL =====
together {
class "channelController" as channelController {
  + listChannels(req, res)
  + getOauthUrl(req, res)
  + oauthCallback(req, res)
  + getPendingAccounts(req, res)
  + connectAccounts(req, res)
  + disconnectChannel(req, res)
}

class "channelService" as channelService {
  + listChannels(workspaceId)
  + createAuthUrl(platform, workspaceId, userId)
  + handleOauthCallback(platform, query)
  + getPendingAccounts(platform, sessionId, userId, workspaceId)
  + connectAccounts(platform, sessionId, userId, workspaceId, accountIds)
  + disconnectChannel(channelId, workspaceId, userId)
  + refreshChannel(channelId, workspaceId, userId)
}

class "channelRepository" as channelRepository {
  + findChannelsByWorkspace(workspaceId)
  + upsertChannels(workspaceId, platform, accounts)
  + findChannelInWorkspace(channelId, workspaceId)
  + findChannelsWithRefreshableTokens(platforms)
  + updateChannelToken(channelId, token)
  + updateChannelStatus(channelId, status)
  + disconnectChannelAndCancelSchedules(channelId)
}

interface "SocialProvider" as socialProvider {
  + platform : SocialPlatform
  + capabilities : ProviderCapabilities
  + isConfigured() : boolean
  + buildAuthorizationUrl(state) : string
  + exchangeCodeForAccounts(code) : SocialAccount[]
  + fetchProfile(accessToken) : SocialProfile
  + publish(input) : string
  + fetchMetrics(externalPostId, accessToken) : ProviderMetrics
  + refreshToken(accessToken) : string
}

class "FacebookProvider" as facebookProvider {
  + platform = FACEBOOK
}

class "ThreadsProvider" as threadsProvider {
  + platform = THREADS
}

class "providerRegistry" as providerRegistry {
  + getProvider(platform) : SocialProvider
  + listProviders() : SocialProvider[]
}

class "channelTokenRefresh" as channelTokenRefresh {
  + refreshChannelTokens() : TokenRefreshResult
}

class "oauthStore" as oauthStore {
  + saveOauthState(state, data)
  + consumeOauthState(state)
  + saveOauthSession(sessionId, session)
  + getOauthSession(sessionId)
  + deleteOauthSession(sessionId)
}
}

' ===== POST =====
together {
class "postController" as postController {
  + createPost(req, res)
  + getPost(req, res)
  + listPosts(req, res)
  + updatePost(req, res)
  + deletePost(req, res)
  + uploadPostMedia(req, res)
  + deletePostMedia(req, res)
  + submitPost(req, res)
  + reviewPost(req, res)
}

class "postService" as postService {
  + createPost(workspaceId, userId, data)
  + getPost(workspaceId, postId)
  + listPosts(workspaceId, query)
  + updatePost(workspaceId, userId, role, postId, data)
  + deletePost(workspaceId, userId, role, postId)
  + uploadPostMedia(workspaceId, userId, role, postId, file?)
  + deletePostMedia(workspaceId, userId, role, postId, mediaId)
  + submitPost(workspaceId, userId, userName, role, postId)
  + reviewPost(workspaceId, reviewerId, postId, data)
  + assignPost(workspaceId, actorId, postId, data)
  + updateTaskStatus(workspaceId, userId, postId, data)
}

class "postRepository" as postRepository {
  + createPost(data)
  + getPostById(postId, workspaceId)
  + listPostsAndCount(params)
  + updatePost(postId, data)
  + transitionPostStatus(postId, workspaceId, from, data)
  + softDeletePost(postId)
  + createMedia(data)
  + softDeleteMedia(mediaId)
}

class "CloudinaryClient" as cloudinaryClient {
  + uploadImageBuffer(buffer, folder)
}
}

' ===== SCHEDULE =====
together {
class "scheduleController" as scheduleController {
  + createSchedules(req, res)
  + listSchedules(req, res)
  + cancelSchedule(req, res)
}

class "scheduleService" as scheduleService {
  + createSchedules(workspaceId, userId, postId, input)
  + listSchedules(workspaceId, query)
  + cancelSchedule(workspaceId, userId, scheduleId)
  + publishSchedule(scheduleId)
  + processDueSchedules()
}

class "scheduleRepository" as scheduleRepository {
  + findPostForSchedule(postId, workspaceId)
  + findChannelsForSchedule(workspaceId, channelIds)
  + createSchedulesForPost(params)
  + listSchedulesAndCount(params)
  + findDueScheduleIds(limit)
  + claimSchedule(scheduleId)
  + markSchedulePublished(scheduleId, externalPostId)
  + markScheduleFailed(scheduleId, errorMessage)
  + rescheduleSchedule(scheduleId, errorMessage, delayMs)
}

class "scheduleProcessor" as scheduleProcessor {
  + processScheduleJob(job)
  + registerScheduleScheduler()
}
}

' ===== BILLING & CREDIT =====
together {
class "billingController" as billingController {
  + getBilling(req, res)
  + listTransactions(req, res)
  + createOrder(req, res)
  + getOrder(req, res)
  + cancelOrder(req, res)
  + handlePayosWebhook(req, res)
}

class "billingService" as billingService {
  + getBilling(workspaceId)
  + listTransactions(workspaceId, query)
  + createOrder(workspaceId, userId, packageId)
  + finalizePaidOrder(order, payosTransId, amount)
  + getOrder(workspaceId, orderId)
  + cancelOrder(workspaceId, orderId, userId)
  + handlePayosWebhook(body)
}

class "billingRepository" as billingRepository {
  + findWorkspaceCredit(workspaceId)
  + listActiveCreditPackages()
  + findCreditPackageById(packageId)
  + createOrder(data)
  + findOrderInWorkspace(orderId, workspaceId)
  + updateOrder(orderId, data)
  + claimPaidOrder(tx, orderId, payosTransId, paidAt)
  + incrementWorkspaceCredit(tx, workspaceId, creditAmount)
  + createCreditTransaction(tx, data)
}

class "PayOSClient" as payosClient {
  + isConfigured()
  + createPaymentLink(input)
  + getPaymentLink(orderCode)
  + cancelPaymentLink(orderCode, reason)
  + verifyWebhook(body)
}

class "creditService" as creditService {
  + reserve(tx, params)
  + refund(tx, params)
}

class "creditRepository" as creditRepository {
  + reserveCredit(tx, params)
  + refundCredit(tx, params)
}
}

' ===== AI =====
together {
class "aiController" as aiController {
  + generateText(req, res)
  + generateImage(req, res)
  + getGeneration(req, res)
}

class "aiService" as aiService {
  + startTextGeneration(params)
  + startImageGeneration(params)
  + getGeneration(params)
  + markProcessing(generationId)
  + completeTextGeneration(generationId, response)
  + completeImageGeneration(params)
  + failGeneration(generationId, message)
}

class "aiRepository" as aiRepository {
  + findGenerationByIdAndWorkspace(generationId, workspaceId)
  + createGeneration(db, data)
  + createDraftPost(db, data)
  + createMediaAsset(db, data)
  + takeGenerationForProcessing(generationId)
  + completeGeneration(generationId, response)
  + failActiveGeneration(db, generationId, errorMessage)
}

class "aiProcessor" as aiProcessor {
  + executeAiGeneration(generationId, attempt)
  + processContentJob(job)
  + buildAiFailureMessage(type, error)
}

class "GeminiClient" as geminiClient {
  + generateJson({ model, systemInstruction, userPrompt, responseSchema })
}

class "CloudflareImageClient" as cloudflareImageClient {
  + generateImage({ model, prompt })
}
}

' ===== ANALYTICS =====
together {
class "analyticsController" as analyticsController {
  + getOverview(req, res)
  + getSuggestions(req, res)
  + triggerSync(req, res)
}

class "analyticsService" as analyticsService {
  + getOverview(workspaceId, query)
  + getSuggestions(workspaceId, query)
  + syncMetrics(options)
}

class "analyticsRepository" as analyticsRepository {
  + findMetricRows(query)
  + findPublishedForSuggestions(params)
  + findDraftPostsForSuggestions(workspaceId)
  + findCampaignTags(workspaceId)
  + findSchedulesToSync(params)
  + saveMetric(scheduledPostId, payload)
  + markMetricError(scheduledPostId, message)
  + markChannelExpired(channelId)
}

class "analyticsProcessor" as analyticsProcessor {
  + processAnalyticsJob(job)
  + registerAnalyticsScheduler()
}
}

' ===== ADMIN =====
together {
class "adminController" as adminController {
  + getStats(req, res)
  + listUsers(req, res)
  + suspendUser(req, res)
  + listWorkspaces(req, res)
}

class "adminService" as adminService {
  + getStats()
  + listUsers(query)
  + setUserSuspension(actorId, targetUserId, data)
  + listWorkspaces(query)
}

class "adminRepository" as adminRepository {
  + getStats()
  + listUsersAndCount(params)
  + findUserForAdmin(userId)
  + updateUserSuspension(userId, suspended)
  + listWorkspacesAndCount(params)
}
}

' ===== NOTIFICATION =====
together {
class "notificationController" as notificationController {
  + listNotifications(req, res)
  + getUnreadCount(req, res)
  + markNotificationRead(req, res)
  + markAllNotificationsRead(req, res)
}

class "notificationService" as notificationService {
  + listNotifications(userId, query)
  + getUnreadCount(userId, workspaceId?)
  + markNotificationRead(userId, notificationId)
  + markAllNotificationsRead(userId, workspaceId?)
}

class "notificationRepository" as notificationRepository {
  + createNotification(data)
  + listNotificationsAndCount(params)
  + countUnread(userId, workspaceId?)
  + markNotificationRead(notificationId, userId)
  + markAllNotificationsRead(userId, workspaceId?)
}
}

