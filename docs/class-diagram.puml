@startuml class-diagram-overview
' ============================================================
' MARKA - SO DO LOP (CLASS DIAGRAM) - Business Layer
' Da bo sung:
'   (1) Thuoc tinh (attribute) cho moi lop  (thay vi chi co method)
'   (2) Lop Domain/Entity day du field
'   (3) Lop Queue (BullMQ) + Worker cho cac module bat dong bo
'   (4) Lop tich hop n8n (workflow automation) - CHI dong bo metrics Facebook (Post Analytics)
' Nguon attribute: backend/prisma/schema.prisma + docs/specs + docs/api_documentation.md
' ============================================================

skinparam dpi 110
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 20
skinparam ranksep 40
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #37474F
  ArrowColor #455A64
  FontSize 12
}
skinparam stereotypeCBackgroundColor #90CAF9

title Marka — Class Diagram (Business + Domain + Automation)

' ============================================================
' 0. DOMAIN / ENTITY (nguon "thuoc tinh" du lieu)
' ============================================================
package "domain — Entity/Model" #E8F5E9 {
